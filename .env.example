# Claude Code API Monitor Configuration v2.0

# Proxy server port (default: 3001)
PROXY_PORT=3001

# Monitor dashboard port (default: 3002)
MONITOR_PORT=3002

# Target Anthropic API URL
TARGET_URL=https://api.anthropic.com

# Claude Code API Base URL (configured to use this monitor)
ANTHROPIC_BASE_URL=http://localhost:3001

# Development mode
NODE_ENV=development

# Optional: Your Anthropic API key (for testing)
# ANTHROPIC_API_KEY=your_api_key_here

# Optional: Custom API URL for frontend (development only)
# VITE_API_URL=http://localhost:3002/api